# Existing
ANTHROPIC_API_KEY=

# xAI / Grok — video generation in the SMA Video Studio.
# Required for video features; lib/sma/xai-video.ts throws if unset.
XAI_API_KEY=

# Supabase (SMA Phase 1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only used as a fallback by the scripts/sma/verify-* E2E scripts.
# The app runtime uses SUPABASE_URL. Set this if you run those scripts locally.
NEXT_PUBLIC_SUPABASE_URL=

# Meta (Instagram, Facebook, Threads)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# 32-byte hex (run: openssl rand -hex 32)
SMA_TOKEN_ENCRYPTION_KEY=

# Vercel Cron auth
CRON_SECRET=

# WhatsApp Advisor (inbound, Cloud API via Coexistence)
# Reuses META_APP_SECRET (signature) and META_WEBHOOK_VERIFY_TOKEN (handshake).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Optional: override to point at a BSP base URL (e.g. 360dialog). Defaults to
# the Meta Cloud API (https://graph.facebook.com/v23.0).
WHATSAPP_API_BASE=
