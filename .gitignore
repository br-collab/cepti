# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch — working folders that sit in the repo root but are not part
# of the app. Code Review/ and Agents/ are also listed in tsconfig.json's
# "exclude": they hold stale copies of lib/sma sources, and without that the
# glob in "include" pulls them into tsc and fails the production build.
Agents/
Code Review/
Corrections/

# retired FFmpeg-era video scratch (superseded by the Grok video pipeline)
public/videos/DFT-*
public/videos/test-*

# Superseded gallery originals.
#
# Since PR #40 every product's image_folder in data/products.json points at
# <slug>/v3/, so the top-level project-*/card/hero files and the whole v2/
# experiment are read by nothing — not getProductImages(), not
# scripts/build-product-images.mjs, not the SMA manifest. Untracked here to
# keep them out of the repo and the Vercel deploy; the files stay on disk
# locally and remain in git history if a gallery ever needs re-cutting.
#
# Exceptions below are genuinely live:
#   texture-01.jpg x4 — hardcoded by components/analyzer/Analyzer.tsx
#   ceramoflex/, granito-liquido/ — no v3 equivalent exists
#   showcase-poster.jpg x5 — posters for the homepage video rail
public/images/products/*/v2/
public/images/products/*/project-*
public/images/products/*/card.*
public/images/products/*/hero.*
public/images/products/*/texture-*
!public/images/products/ladriflex/texture-01.jpg
!public/images/products/papelex/texture-01.jpg
!public/images/products/pintura-aterciopelada/texture-01.jpg
!public/images/products/pintura-efecto-granito/texture-01.jpg
!public/images/products/ceramoflex/texture-*
!public/images/products/granito-liquido/texture-*
